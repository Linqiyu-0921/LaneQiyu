---
import { PFSearch } from 'astro-pure/components/pages'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

const meta = {
  description: 'Search posts on this site',
  title: 'Search'
}
---

<PageLayout {meta}>
  <Button href='/blog' variant='back'><span data-i18n='common.back'>Back</span></Button>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium' data-i18n='search.title'>Search</h1>
    </div>

    <div id='content' class='animate'>
      {
        integ.pagefind ? (
          <>
            <p data-i18n='search.hint'>Enter a keyword to search posts on this site.</p>
            <PFSearch />
          </>
        ) : (
          <p>Site search is currently disabled.</p>
        )
      }
    </div>
  </main>
</PageLayout>
