---
import PageLayout from '@/layouts/BaseLayout.astro'

const themes = [
  { number: '01', title: 'city', mark: '◌' },
  { number: '02', title: 'space', mark: '⌁' },
  { number: '03', title: 'everyday', mark: '✳' }
]
---

<PageLayout meta={{ title: 'Field Notes', description: 'A personal journal of places and observations.' }}>
  <main class='field-notes'>
    <section class='field-hero' aria-labelledby='field-title'>
      <div class='hero-copy'>
        <p class='eyebrow'><span class='status-dot'></span><span data-i18n='field.eyebrow'>A PERSONAL FIELD JOURNAL</span></p>
        <h1 id='field-title'>Field<br /><em>Notes.</em></h1>
        <p class='hero-subtitle' data-i18n='field.intro'>Notes on places, movement, and the details along the way.</p>
        <p class='hero-description' data-i18n='field.description'>A growing collection of observations, photographs and fragments from everyday life.</p>
      </div>
      <div class='field-illustration' aria-hidden='true'>
        <div class='grid-lines'></div>
        <div class='orbit orbit-one'></div><div class='orbit orbit-two'></div><div class='orbit orbit-three'></div>
        <span class='art-label art-top'>FIELD / 01</span><span class='art-cross'>✳</span>
        <span class='art-label art-bottom'>LOOK CLOSER<br />STAY CURIOUS</span>
        <span class='art-coordinate'>31° N &nbsp; 118° E</span>
      </div>
    </section>

    <section class='field-index' aria-labelledby='index-title'>
      <div class='section-heading'>
        <div><p class='eyebrow' data-i18n='field.index'>THE FIELD INDEX</p><h2 id='index-title' data-i18n='field.indexTitle'>Ways of looking</h2></div>
        <p data-i18n='field.indexDesc'>A few starting points for paying attention.</p>
      </div>
      <div class='themes'>
        {themes.map((theme) => (
          <article class='theme'>
            <div class='theme-top'><span>{theme.number} /</span><span class='theme-mark' aria-hidden='true'>{theme.mark}</span></div>
            <h3 data-i18n={`field.${theme.title}`}>{theme.title}</h3>
            <p data-i18n={`field.${theme.title}Desc`}></p>
          </article>
        ))}
      </div>
    </section>

    <section class='journal' aria-labelledby='journal-title'>
      <div class='section-heading'>
        <div><p class='eyebrow' data-i18n='field.archive'>FIELD JOURNAL</p><h2 id='journal-title' data-i18n='field.latest'>Collected notes</h2></div>
        <span class='journal-count'>00 / NOTES</span>
      </div>
      <div class='empty-state'>
        <span class='empty-symbol' aria-hidden='true'>✳</span>
        <p class='empty-title' data-i18n='field.emptyTitle'>The first note is still on its way.</p>
        <p data-i18n='field.emptyDesc'>This space is ready for observations from the road.</p>
      </div>
      <div class='field-end'><span>LANE QIYU / FIELD NOTES</span><span data-i18n='field.end'>A PLACE TO BEGIN</span></div>
    </section>
  </main>
</PageLayout>

<style>
  .field-notes { width: 100%; padding-bottom: 2rem; }
  .field-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .8fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; padding: 2rem 0 5.5rem; }
  .eyebrow, .journal-count, .field-end, .theme-top, .art-label, .art-coordinate { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .11em; font-size: .65rem; font-weight: 600; }
  .eyebrow { color: hsl(var(--muted-foreground)); display: flex; align-items: center; gap: .6rem; }
  .status-dot { width: .45rem; height: .45rem; border-radius: 50%; background: hsl(var(--primary)); }
  h1 { margin: 2rem 0 1.5rem; font-family: Georgia, 'Times New Roman', serif; font-weight: 400; font-size: clamp(4.5rem, 9vw, 8rem); letter-spacing: -.065em; line-height: .83; }
  h1 em { color: hsl(var(--primary)); font-weight: 400; }
  .hero-subtitle { max-width: 28rem; font-size: clamp(1.05rem, 1.7vw, 1.35rem); line-height: 1.5; }
  .hero-description { max-width: 25rem; margin-top: 1rem; color: hsl(var(--muted-foreground)); line-height: 1.8; font-size: .87rem; }
  .field-illustration { position: relative; overflow: hidden; aspect-ratio: 1 / 1.08; border: 1px solid hsl(var(--border)); border-radius: .8rem; background: hsl(var(--muted)); color: hsl(var(--primary)); }
  .grid-lines { position: absolute; inset: 0; opacity: .33; background-image: linear-gradient(hsl(var(--primary) / .4) 1px, transparent 1px), linear-gradient(90deg, hsl(var(--primary) / .4) 1px, transparent 1px); background-size: 2.5rem 2.5rem; }
  .orbit { position: absolute; border: 1px solid hsl(var(--primary) / .38); border-radius: 50%; left: 50%; top: 48%; transform: translate(-50%, -50%) rotate(-22deg); }
  .orbit-one { width: 65%; height: 65%; }.orbit-two { width: 78%; height: 51%; }.orbit-three { width: 49%; height: 78%; }
  .art-label, .art-coordinate, .art-cross { position: absolute; }.art-top { left: 1.5rem; top: 1.5rem; }.art-bottom { left: 1.5rem; bottom: 1.5rem; line-height: 1.7; }.art-coordinate { right: 1.5rem; bottom: 1.5rem; }.art-cross { top: 44%; left: 46%; font-size: 2.2rem; font-weight: 300; }
  .field-index, .journal { border-top: 1px solid hsl(var(--border)); padding-top: 2rem; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; }
  .section-heading h2 { margin: .65rem 0 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 400; letter-spacing: -.035em; }
  .section-heading > p { color: hsl(var(--muted-foreground)); font-size: .8rem; }
  .themes { display: grid; grid-template-columns: repeat(3, 1fr); margin: 2rem 0 5rem; border-top: 1px solid hsl(var(--border)); border-bottom: 1px solid hsl(var(--border)); }
  .theme { padding: 1.3rem 1.5rem 1.8rem; min-height: 12rem; }.theme:first-child { padding-left: 0; }.theme + .theme { border-left: 1px solid hsl(var(--border)); }
  .theme-top { color: hsl(var(--muted-foreground)); display: flex; align-items: center; justify-content: space-between; }.theme-mark { font-size: 1.8rem; color: hsl(var(--primary)); font-family: Georgia, serif; }
  .theme h3 { margin: 2rem 0 .65rem; font-size: 1rem; font-weight: 600; }.theme p { color: hsl(var(--muted-foreground)); font-size: .8rem; line-height: 1.7; max-width: 15rem; }
  .journal-count { color: hsl(var(--muted-foreground)); white-space: nowrap; }.empty-state { margin-top: 2rem; min-height: 13rem; border: 1px dashed hsl(var(--border)); border-radius: .8rem; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; color: hsl(var(--muted-foreground)); font-size: .83rem; line-height: 1.7; }
  .empty-symbol { color: hsl(var(--primary)); font-size: 1.5rem; }.empty-title { color: hsl(var(--foreground)); margin: .9rem 0 .25rem; font-size: 1rem; font-weight: 500; }
  .field-end { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1.2rem; color: hsl(var(--muted-foreground)); font-size: .59rem; }
  @media (max-width: 640px) { .field-hero { grid-template-columns: 1fr; gap: 2.5rem; padding: .5rem 0 4rem; } h1 { font-size: clamp(4.5rem, 20vw, 6rem); } .field-illustration { aspect-ratio: 1.3; } .section-heading { align-items: start; flex-direction: column; } .themes { grid-template-columns: 1fr; margin-bottom: 4rem; }.theme, .theme:first-child { min-height: auto; padding: 1.1rem 0 1.5rem; }.theme + .theme { border-left: 0; border-top: 1px solid hsl(var(--border)); }.theme h3 { margin-top: .9rem; }.theme p { max-width: none; } }
</style>
