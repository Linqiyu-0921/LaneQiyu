---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const projects = await getCollection('projects')
const sortedProjects = projects.sort((a, b) => (a.data.order || 999) - (b.data.order || 999))

---

<PageLayout title='Projects'>
  <p data-i18n='projects.github'>GitHub activity:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/Linqiyu-0921'
      class='github-chart'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  <h2 data-i18n='projects.list'>Selected projects</h2>
  <ProjectSection
    projects={sortedProjects.map((p) => ({
      name: p.data.title,
      description: p.data.description,
      links: p.data.links.map((l) => ({ type: l.type, href: l.href }))
    }))}
  />
</PageLayout>
