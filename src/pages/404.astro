---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: '页面不存在',
  title: '404'
}
---

<PageLayout {meta}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground' data-i18n='notfound.hint'>页面好像走丢了。</p>
    <p class='text-lg' data-i18n='notfound.desc'>抱歉，没有找到你要找的页面。</p>
    <Button href='/' variant='ahead' class='mt-5'><span data-i18n='notfound.home'>回到首页</span></Button>
  </div>
</PageLayout>
