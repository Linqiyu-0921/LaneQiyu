---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: 'Page not found',
  title: '404'
}
---

<PageLayout {meta}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground' data-i18n='notfound.hint'>This page seems to be lost.</p>
    <p class='text-lg' data-i18n='notfound.desc'>Sorry, we couldn't find the page you're looking for.</p>
    <Button href='/' variant='ahead' class='mt-5'><span data-i18n='notfound.home'>Back to home</span></Button>
  </div>
</PageLayout>
