---

<section id='wechat' class='wechat' aria-labelledby='wechat-title'>
  <div class='wechat-heading'>
    <h2 id='wechat-title' data-i18n='blog.wechatTitle'>WeChat articles</h2>
    <p lang='zh-CN'>乘以零的万能删除</p>
  </div>

  <ul class='article-grid'>
    {articles.map((article, index) => (
      <li class:list={{ featured: index === 0 }}>
        <article class='article-card' lang='zh-CN'>
          <img
            class='article-cover'
            src={article.cover}
            alt=''
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding='async'
          />
          <div class='article-copy'>
            <time datetime={article.date}>{article.date}</time>
            <h3><a href={article.url}>{article.title}</a></h3>
            <p>{article.excerpt}</p>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .wechat {
    margin-block-start: 2.5rem;
    scroll-margin-top: 6rem;
  }

  .wechat-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .65rem 1rem;
    border-block-end: 1px solid hsl(var(--border));
    padding-block-end: 1rem;
    margin-block-end: 1.5rem;
  }

  .wechat-heading h2 {
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 600;
  }

  .wechat-heading p,
  time,
  .article-copy p {
    color: hsl(var(--muted-foreground));
  }

  .wechat-heading p,
  time {
    font-size: .8rem;
  }

  .article-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .article-grid li {
    min-width: 0;
  }

  .article-grid .featured {
    grid-column: 1 / -1;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: .9rem;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
  }

  h3 a {
    display: block;
    text-decoration: underline;
    text-decoration-color: hsl(var(--primary) / .35);
    text-underline-offset: .2em;
  }

  h3 a:hover {
    text-decoration-color: currentColor;
  }

  h3 a:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }

  .article-cover {
    display: block;
    width: 100%;
    aspect-ratio: 2.35;
    object-fit: cover;
    background: hsl(var(--muted));
  }

  .article-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: .6rem;
    padding: 1.2rem;
  }

  time {
    font-variant-numeric: tabular-nums;
    letter-spacing: .025em;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .article-copy p {
    font-size: .9rem;
    line-height: 1.75;
  }

  .featured .article-card {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
  }

  .featured .article-cover {
    height: 100%;
  }

  .featured .article-copy {
    padding: clamp(1.4rem, 4vw, 2.25rem);
  }

  .featured h3 {
    font-size: clamp(1.3rem, 2.6vw, 1.85rem);
  }

  @media (max-width: 900px) {
    .article-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .article-grid,
    .featured .article-card { grid-template-columns: minmax(0, 1fr); }
    .featured .article-cover { height: auto; }
  }
</style>
