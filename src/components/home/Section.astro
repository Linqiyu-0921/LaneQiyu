---
import { cn } from 'astro-pure/utils'

const { class: className, title, i18n } = Astro.props
---

<section class={cn('flex flex-col gap-y-5 md:flex-row md:items-end', className)}>
  <h2 class='text-xl font-semibold md:min-w-36' data-i18n={i18n}>{title}</h2>
  <div class='flex flex-1 flex-col gap-y-3'>
    <slot />
  </div>
</section>
