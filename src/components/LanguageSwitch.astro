---
import { langLabels } from '@/i18n/ui'

const langs = ['zh', 'en', 'zh-Hant'] as const
---

<div
  class='lang-switch flex items-center rounded-md border text-xs text-muted-foreground'
  role='group'
  aria-label='Language / 语言'
>
  {
    langs.map((lang) => (
      <button
        type='button'
        data-lang={lang}
        class='lang-btn px-1.5 py-1 transition-colors hover:text-foreground first:rounded-s-md last:rounded-e-md'
      >
        {langLabels[lang]}
      </button>
    ))
  }
</div>

<style>
  .lang-btn[aria-pressed='true'] {
    background-color: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
</style>

<script>
  import { dictionaries, titleKeyFor, type Lang } from '@/i18n/ui'

  const STORAGE_KEY = 'lang'
  const isLang = (value: string | null): value is Lang =>
    value === 'zh' || value === 'en' || value === 'zh-Hant'

  function detectLang(): Lang {
    const saved = localStorage.getItem(STORAGE_KEY)
    if (isLang(saved)) return saved
    const candidates = navigator.languages?.length ? navigator.languages : [navigator.language]
    for (const raw of candidates) {
      const value = raw.toLowerCase()
      if (value.startsWith('zh')) return /hant|tw|hk|mo/.test(value) ? 'zh-Hant' : 'zh'
      if (value.startsWith('en')) return 'en'
    }
    return 'zh'
  }

  function translate(lang: Lang) {
    const dict = dictionaries[lang]
    const fallback = dictionaries.zh
    const pick = (key: string) => dict[key] ?? fallback[key]

    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const text = pick(el.dataset.i18n ?? '')
      if (text != null) el.textContent = text
    })
    document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((el) => {
      const text = pick(el.dataset.i18nAria ?? '')
      if (text != null) el.setAttribute('aria-label', text)
    })
    document.querySelectorAll<HTMLElement>('[data-i18n-title]').forEach((el) => {
      const text = pick(el.dataset.i18nTitle ?? '')
      if (text != null) el.setAttribute('title', text)
    })

    document.documentElement.lang = lang === 'en' ? 'en' : lang === 'zh-Hant' ? 'zh-Hant' : 'zh-CN'

    // 侧边 TOC 由主题包生成，按 slug 同步文案
    const tocKeys: Record<string, Record<string, string>> = {
      '/about/': {
        education: 'about.education',
        hobbies: 'about.hobbies',
        tools: 'about.tools',
        'social-networks': 'about.social',
        timeline: 'about.timeline',
        contact: 'about.contact'
      },
      '/writing/': { articles: 'writing.articles' }
    }
    Object.entries(tocKeys[location.pathname] ?? {}).forEach(([slug, key]) => {
      const link = document.querySelector<HTMLElement>(`a.toc-item[href="#${slug}"]`)
      if (link) link.textContent = pick(key)
    })

    const titleKey = titleKeyFor(location.pathname)
    if (titleKey) {
      const site = document.title.split(' • ').pop() ?? ''
      document.title = `${pick(titleKey)} • ${site}`
    }

    document.querySelectorAll<HTMLElement>('.lang-btn').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.lang === lang))
    })
  }

  function setLang(lang: Lang) {
    localStorage.setItem(STORAGE_KEY, lang)
    translate(lang)
  }

  const initial = detectLang()
  translate(initial)

  document.querySelectorAll<HTMLElement>('.lang-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang
      if (isLang(lang ?? null)) setLang(lang as Lang)
    })
  })
</script>
